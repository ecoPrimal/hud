  "plasmid_count": 68,
  "transposon_mechanics": {
    "what": "a transposon is a JUMPING GENE — it moves within and between genomes",
    "biology": {
      "class_I": "retrotransposon — copy-and-paste (RNA intermediate). plasmid STAYS and COPY moves.",
      "class_II": "DNA transposon — cut-and-paste. plasmid MOVES. original location loses it."
    },
    "in_gaia": {
      "membrane_to_internal": "visitor brings plasmid → absorbed into genome (like horizontal gene transfer / conjugation)",
      "internal_to_membrane": "organism exports plasmid to membrane → available for next visitor to take",
      "clone_to_clone": "shadow clone disperses → plasmids transfer between clones (like bacterial conjugation)",
      "enzyme_to_enzyme": "one enzyme's hole-plasmid can be swapped to complement another enzyme"
    },
    "is_memory": true,
    "memory_types": {
      "short_term": "membrane plasmids — recent, volatile, can be lost on page close",
      "long_term": "internal plasmids — integrated into genome, persists across sessions",
      "shared": "transferred plasmids — memory that came from another organism/visitor",
      "inherited": "daughter plasmids — memory that budded from solved bounties"
    },
    "usb_drive_analogy": {
      "plug_in": "visitor arrives → clone receives their plasmids (shadow clone conjugation)",
      "read": "enzyme reads plasmid → fills its own hole → catalyzes new substrates",
      "write": "catalysis produces new plasmid → written to memory",
      "eject": "visitor leaves → plasmid disperses back to host organism (memory merge)",
      "swap": "plasmid moves from membrane to internal (or reverse) — like moving USB to internal SSD"
    }
  },
