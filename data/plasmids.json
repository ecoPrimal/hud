  "title": "💿 PLASMIDS — eat the enzyme, find the hole, forge the portable memory",
  "etymology": {
    "plasmid": "Greek plasma — something formed/molded. extra-chromosomal self-replicating DNA. USB DRIVE of biology.",
    "transposon": "Latin transponere — to put across. JUMPING GENE. moveable genetic element. Barbara McClintock, 1948.",
    "conjugation": "Latin conjugare — to join together. bacterial sex = plasmid transfer. horizontal gene transfer."
  },
  "process": {
    "1_eat_enzyme": "analyze each enzyme's coverage to find what it DOESN'T reach",
    "2_find_holes": "gaps in coverage = topics no enzyme catalyzes",
    "3_forge_plasmid": "each hole becomes a portable, self-replicating, transferable package",
    "4_transposon": "plasmids MOVE between membrane (external) and internal (genome)",
    "5_is_memory": "plasmids ARE memory — portable, swappable, inheritable"
  },
