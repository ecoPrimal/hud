{
  "name": "HUD — Human Universe Display",
  "short_name": "HUD",
  "description": "Sovereign observation surface. A chipmunk inside a living membrane. No cookies. No tracking.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "theme_color": "#0d1117",
  "background_color": "#0d1117",
  "categories": ["education", "productivity", "utilities"],
  "lang": "en",
  "dir": "ltr",
  "id": "hud-primals-eco",
  "icons": [
    {
      "src": "/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "screenshots": [],
  "shortcuts": [
    {
      "name": "Campfire",
      "short_name": "🔥",
      "url": "/?view=campfire",
      "description": "Campfire stories"
    },
    {
      "name": "Neutron",
      "short_name": "◉",
      "url": "/neutron/core.html",
      "description": "Neutron observer core"
    },
    {
      "name": "sporePrint",
      "short_name": "📄",
      "url": "https://sporeprint.primals.eco",
      "description": "Research papers"
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "handle_links": "preferred",
  "share_target": {
    "action": "/?share-target",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+hud",
      "url": "/?protocol=%s"
    }
  ]
}
