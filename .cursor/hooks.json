{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": "node .cursor/hooks/gaia-sow.js",
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node C:/Users/mokke/Desktop/Gaia3/hooks/bench-hook.js",
        "failClosed": true,
        "timeout": 8
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/gaia-sow.js",
        "matcher": "index\\.html|gaia-seed\\.json|js/.+\\.js",
        "timeout": 10
      }
    ]
  }
}
