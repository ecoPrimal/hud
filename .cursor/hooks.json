{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": "node .cursor/hooks/gaia-sow.js",
        "timeout": 10
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/gaia-sow.js",
        "matcher": "index\\.html|gaia-seed\\.json|js/.+\\.js",
        "timeout": 10
      }
    ]
  }
}
