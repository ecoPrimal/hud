  "anti_sigmoid": {
    "concept": "every organism in the tree has an anti-sigmoid \u2014 a zone where more growth makes it WORSE",
    "by_type": {
      "primals": "more code without tests = the uncanny valley of software. barraCuda at 297K lines with lowest test density = deepest in the valley.",
      "models": "more parameters without grounding = the uncanny valley of AI. hallucination increases with model size up to a point.",
      "js_families": "more JS without users = the uncanny valley of features. 224 dark data files = features nobody asked for.",
      "data_strata": "more data without indexing = the uncanny valley of knowledge. you HAVE it but can't FIND it."
    },
    "the_formula": "UV(x) = \u03c3(x) - 0.6\u00b7exp(-((x-0.85)\u00b2)/(2\u00b70.08\u00b2))",
    "navigation": "for each organism: identify where on the x-axis it sits. if 0.8 < x < 0.9, you're IN the valley. push through or pull back."
  }
